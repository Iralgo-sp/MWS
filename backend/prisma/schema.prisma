// Nota: SQLite no soporta enums nativos en Prisma, así que los tipos
// (vehicle.type, maintenance.type, insurance.type) se validan como
// strings de una lista cerrada en el backend (ver src/types.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Vehicle {
  id            String   @id @default(cuid())
  type          String // bici | moto | coche | otro
  alias         String
  brand         String?
  model         String?
  year          Int?
  plate         String? // matrícula o nº de bastidor
  purchaseDate  DateTime?
  purchasePrice Float?
  notes         String?
  status        String   @default("activo") // activo | vendido
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Concesionario / venta
  dealerName    String?
  dealerAddress String?
  dealerAgent   String? // comercial/agente de ventas

  // Forma de pago
  paymentMethod         String  @default("contado") // contado | financiado
  financingLender       String? // entidad financiera
  financingAmount       Float? // importe financiado
  financingInterestRate Float? // interés (%)
  financingTermMonths   Int? // plazo en meses
  financingNotes        String?

  maintenanceRecords MaintenanceRecord[]
  insurancePolicies  InsurancePolicy[]
  installments       Installment[]
  documents          Document[]
}

model MaintenanceRecord {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date        DateTime
  type        String // reparacion | revision | itv | otro
  description String
  cost        Float?
  workshop    String?
  mileage     Int?
  createdAt   DateTime @default(now())
}

model InsurancePolicy {
  id           String    @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  company      String
  policyNumber String
  type         String // terceros | todo_riesgo | otro
  startDate    DateTime
  endDate      DateTime?
  annualCost   Float?
  notes        String?
  createdAt    DateTime  @default(now())
}

model Installment {
  id                String   @id @default(cuid())
  vehicleId         String
  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  paymentDate       DateTime
  installmentNumber Int?
  principalAmount   Float? // base/capital
  interestAmount    Float?
  totalAmount       Float?
  notes             String?
  createdAt         DateTime @default(now())
}

model Document {
  id             String   @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  label          String // p.ej. "Factura de compra", "Contrato de financiación"
  originalName   String
  storedFilename String // nombre físico en disco, evita colisiones
  mimeType       String
  size           Int
  uploadedAt     DateTime @default(now())
}
