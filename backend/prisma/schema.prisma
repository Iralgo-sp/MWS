// Nota: SQLite no soporta enums nativos en Prisma, así que los tipos
// (vehicle.type, maintenance.type, insurance.type) se validan como
// strings de una lista cerrada en el backend (ver src/types.ts).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Vehicle {
  id            String   @id @default(cuid())
  type          String // bici | moto | coche | otro
  alias         String
  brand         String?
  model         String?
  year          Int?
  plate         String? // matrícula
  chassis       String? // número de bastidor / VIN
  color         String?
  purchaseDate  DateTime?
  purchasePrice Float?
  notes         String?
  status        String   @default("activo") // activo | vendido
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Concesionario / venta
  dealerName    String?
  dealerAddress String?
  dealerAgent   String? // comercial/agente de ventas

  // Forma de pago
  paymentMethod         String  @default("contado") // contado | financiado
  financingLender       String? // entidad financiera
  financingAmount       Float? // importe financiado
  financingInterestRate Float? // interés (%)
  financingTermMonths   Int? // plazo en meses
  financingNotes        String?

  // Recordatorios proactivos
  nextItv           DateTime?
  serviceIntervalKm Int?

  maintenanceRecords MaintenanceRecord[]
  insurancePolicies  InsurancePolicy[]
  installments       Installment[]
  documents          Document[]
  odometerReadings   OdometerReading[]
}

model MaintenanceRecord {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date        DateTime
  type        String // reparacion | revision | itv | otro
  description String
  cost        Float?
  workshop    String?
  mileage     Int?
  createdAt   DateTime @default(now())
  documents   Document[]
}

model InsurancePolicy {
  id           String    @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  year         Int       // año de la póliza (p.ej. 2025)
  status       String    @default("presupuesto") // presupuesto | activa | descartada
  isSelected   Boolean   @default(false) // presupuesto ganador del año
  company      String
  policyNumber String    @default("") // nº de póliza (vacío en presupuestos)
  type         String // terceros | terceros_ampliado | todo_riesgo | otro
  startDate    DateTime
  endDate      DateTime?
  annualCost      Float?
  hasFranchise    Boolean  @default(false)
  franchiseAmount Float?
  notes           String?
  createdAt       DateTime  @default(now())
  documents       Document[]
}

model Installment {
  id                String   @id @default(cuid())
  vehicleId         String
  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  paymentDate       DateTime
  concept           String   @default("cuota") // entrada | pago_previo | pago_final | cuota | otro
  isPaid            Boolean  @default(false)
  installmentNumber Int?
  principalAmount   Float? // base/capital
  interestAmount    Float?
  totalAmount       Float?
  remainingBalance  Float? // saldo pendiente tras el pago
  notes             String?
  createdAt         DateTime @default(now())
}

model OdometerReading {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date      DateTime
  mileage   Int
  notes     String?
  createdAt DateTime @default(now())
}

model Document {
  id                  String             @id @default(cuid())
  vehicleId           String
  vehicle             Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  maintenanceRecordId String?
  maintenanceRecord   MaintenanceRecord? @relation(fields: [maintenanceRecordId], references: [id], onDelete: Cascade)
  insurancePolicyId   String?
  insurancePolicy     InsurancePolicy?   @relation(fields: [insurancePolicyId], references: [id], onDelete: Cascade)
  label               String // p.ej. "Factura de compra", "Contrato de financiación"
  originalName        String
  storedFilename      String // nombre físico en disco, evita colisiones
  mimeType            String
  size                Int
  uploadedAt          DateTime           @default(now())
}
